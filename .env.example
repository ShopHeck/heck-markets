# Kalshi API v2 auth — create a key at https://kalshi.com → Account → API Keys
KALSHI_KEY_ID=
# Paste the PEM contents (multiline supported) — in Devin, a file path won't exist
KALSHI_PRIVATE_KEY=
# KALSHI_PRIVATE_KEY_PATH=keys/kalshi.pem

# Polymarket — only needed for authenticated CLOB trading, not for reading markets
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# paper (default) | live — live order placement is intentionally not implemented
TRADING_MODE=paper
